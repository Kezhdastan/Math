# ============================================================
# ГЛАВНЫЙ ДВИЖОК
# ============================================================

def solve(text):

    command = text.lower().strip()

    if command == "help":
        help_command()
        return ""

    if command == "system":
        return system_command()

    if command.startswith("factorial"):
        return factorial_command(text)

    if command.startswith("trig"):
        return trig_command(text)

    if command.startswith("diff"):
        return derivative_command(text)

    if command.startswith("integral"):
        return integral_command(text)

    if command.startswith("limit"):
        return limit_command(text)

    if command.startswith("matrix"):
        return matrix_command(text)

    if command.startswith("inequality"):
        return inequality_command(text)

    if command.startswith("pythagoras"):
        return pythagoras_command(text)

    # Если есть "=" — решаем как уравнение
    if "=" in text:
        return equation_command(text)

    # Иначе обычный калькулятор
    return calculator(text)


# ============================================================
# ЗАПУСК
# ============================================================

def main():

    print("""
╔══════════════════════════════════════════╗
║          EXACT MATH SOLVER 2.1          ║
║             Python + SymPy              ║
╚══════════════════════════════════════════╝

Напиши help, чтобы увидеть команды.
""")

    while True:

        text = input(">>> ").strip()

        if text.lower() in (
            "exit",
            "quit",
            "выход"
        ):
            print("Пока 👋")
            break

        if not text:
            continue

        try:

            result = solve(text)

            if result != "":
                print(result)

        except Exception as error:

            print("❌ Ошибка:")
            print(error)


# ============================================================
# СТАРТ ПРОГРАММЫ
# ============================================================

if __name__ == "__main__":
    main()
