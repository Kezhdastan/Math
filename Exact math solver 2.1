import sympy as sp

# ============================================================
# EXACT MATH SOLVER 2.1
# ============================================================

x, y, z = sp.symbols("x y z")

LOCAL = {
    "x": x,
    "y": y,
    "z": z,

    "i": sp.I,
    "I": sp.I,

    "pi": sp.pi,
    "π": sp.pi,
    "e": sp.E,

    "sqrt": sp.sqrt,

    "sin": sp.sin,
    "cos": sp.cos,
    "tan": sp.tan,
    "cot": sp.cot,

    "asin": sp.asin,
    "acos": sp.acos,
    "atan": sp.atan,

    "ln": sp.log,
    "log": sp.log,
    "exp": sp.exp,

    "factorial": sp.factorial,
}


# ============================================================
# ПАРСИНГ МАТЕМАТИКИ
# ============================================================

def parse_math(text):
    text = text.strip()

    text = text.replace("^", "**")
    text = text.replace("√", "sqrt")
    text = text.replace("π", "pi")
    text = text.replace("tg", "tan")
    text = text.replace("ctg", "cot")

    return sp.sympify(text, locals=LOCAL)


# ============================================================
# БАЗОВЫЙ КАЛЬКУЛЯТОР
# ============================================================

def calculator(text):
    result = parse_math(text)
    return sp.simplify(result)


# ============================================================
# ФАКТОРИАЛ
# ============================================================

def factorial_command(text):
    value = text[len("factorial"):].strip()

    if not value:
        return "Пример: factorial 5"

    n = parse_math(value)

    return sp.factorial(n)


# ============================================================
# ТРИГОНОМЕТРИЯ
# ============================================================

def trig_command(text):
    expression = text[len("trig"):].strip()

    if not expression:
        return "Пример: trig sin(pi/6)"

    result = parse_math(expression)

    return sp.simplify(result)


# ============================================================
# ПРОИЗВОДНАЯ
# ============================================================

def derivative_command(text):
    expression = text[len("diff"):].strip()

    if not expression:
        return "Пример: diff x^3"

    parts = expression.split(",")

    function = parse_math(parts[0])

    variable = x

    if len(parts) > 1:
        variable = parse_math(parts[1])

    return sp.simplify(
        sp.diff(function, variable)
    )


# ============================================================
# ИНТЕГРАЛ
# ============================================================

def integral_command(text):
    expression = text[len("integral"):].strip()

    if not expression:
        return "Пример: integral x^2"

    parts = expression.split(",")

    function = parse_math(parts[0])

    variable = x

    if len(parts) > 1:
        variable = parse_math(parts[1])

    result = sp.integrate(
        function,
        variable
    )

    return result


# ============================================================
# ПРЕДЕЛ
# ============================================================

def limit_command(text):
    expression = text[len("limit"):].strip()

    parts = expression.split(",")

    if len(parts) != 3:
        return "Пример: limit sin(x)/x, x, 0"

    function = parse_math(parts[0])
    variable = parse_math(parts[1])
    point = parse_math(parts[2])

    return sp.limit(
        function,
        variable,
        point
    )


# ============================================================
# МАТРИЦЫ
# ============================================================

def matrix_command(text):
    expression = text[len("matrix"):].strip()

    if not expression:
        return "Пример: matrix [[1,2],[3,4]]"

    try:
        matrix = sp.Matrix(
            eval(
                expression,
                {"__builtins__": {}},
                {}
            )
        )

        print("\nМатрица:")
        print(matrix)

        print("\nРазмер:")
        print(f"{matrix.rows} x {matrix.cols}")

        if matrix.rows == matrix.cols:

            print("\nОпределитель:")
            print(matrix.det())

            if matrix.det() != 0:
                print("\nОбратная матрица:")
                print(matrix.inv())

        return ""

    except Exception:
        return "Ошибка. Пример: matrix [[1,2],[3,4]]"


# ============================================================
# УРАВНЕНИЯ
# ============================================================

def equation_command(text):

    if "=" not in text:
        return "Пример: x^2-5*x+6=0"

    left, right = text.split("=", 1)

    left = parse_math(left)
    right = parse_math(right)

    equation = sp.Eq(left, right)

    solutions = sp.solve(
        equation,
        x
    )

    if not solutions:
        return "Нет решений."

    result = []

    for solution in solutions:
        result.append(
            f"x = {sp.simplify(solution)}"
        )

    return "\n".join(result)


# ============================================================
# СИСТЕМЫ УРАВНЕНИЙ
# ============================================================

def system_command():

    print()
    print("Вводи уравнения.")
    print("Когда закончишь — напиши done.")
    print()

    equations = []

    while True:

        text = input("eq >>> ").strip()

        if text.lower() == "done":
            break

        if "=" not in text:
            print("Используй знак =")
            continue

        left, right = text.split("=", 1)

        try:

            equation = sp.Eq(
                parse_math(left),
                parse_math(right)
            )

            equations.append(equation)

        except Exception:
            print("Не удалось распознать уравнение.")

    if not equations:
        return "Система пустая."

    solutions = sp.solve(
        equations,
        [x, y, z],
        dict=True
    )

    if not solutions:
        return "Решений нет."

    answer = []

    for variable, value in solutions[0].items():
        answer.append(
            f"{variable} = {sp.simplify(value)}"
        )

    return "\n".join(answer)


# ============================================================
# НЕРАВЕНСТВА
# ============================================================

def inequality_command(text):

    expression = text[len("inequality"):].strip()

    if "<=" in expression:

        left, right = expression.split("<=", 1)
        result = sp.solve_univariate_inequality(
            parse_math(left) <= parse_math(right),
            x
        )

    elif ">=" in expression:

        left, right = expression.split(">=", 1)
        result = sp.solve_univariate_inequality(
            parse_math(left) >= parse_math(right),
            x
        )

    elif "<" in expression:

        left, right = expression.split("<", 1)
        result = sp.solve_univariate_inequality(
            parse_math(left) < parse_math(right),
            x
        )

    elif ">" in expression:

        left, right = expression.split(">", 1)
        result = sp.solve_univariate_inequality(
            parse_math(left) > parse_math(right),
            x
        )

    else:
        return "Пример: inequality x^2-4<0"

    return result


# ============================================================
# ТЕОРЕМА ПИФАГОРА
# ============================================================

def pythagoras_command(text):

    expression = text[len("pythagoras"):].strip()

    try:

        a, b = expression.split(",")

        a = parse_math(a)
        b = parse_math(b)

        c = sp.sqrt(
            a**2 + b**2
        )

        return f"c = {sp.simplify(c)}"

    except Exception:

        return "Пример: pythagoras 3,4"


# ============================================================
# ПОМОЩЬ
# ============================================================

